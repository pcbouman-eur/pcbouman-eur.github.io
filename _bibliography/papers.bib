@inproceedings{0e66266a193a400e8e33496e1030f5a7,
  title     = "Simple Policies for Capacitated Resupply Problems",
  abstract  = "We consider the Capacitated Resupply Problem in which locations with a given demand rate should be resupplied by vehicles such that they do not run out of stock and the number of vehicles is minimised. Compared to related problems, we consider the scenario where the payload of the vehicles may not suffice to bring the stock level back to full capacity. We focus on the Homogeneous Capacitated Resupply Problem and present both simple policies that provide 2-Approximations and an optimal greedy policy that runs in pseudo-polynomial time.",
  author    = "Mette Wagenvoort and Ee, \{Martijn Van\} and Paul Bouman and Malone, \{Kerry M.\}",
